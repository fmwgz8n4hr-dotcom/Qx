#!name=飞常准 进港排队全天
#!desc=v16 探针版：功能同 v14，额外用同一个签名去打 /v4/airport/getQueueList。用法：重启 App 进排队页，把 [feeyo u2] 开头几行发回。

[mitm]
hostname = app.variflight.com, *.variflight.com

[rewrite_local]

^https?:\/\/app\.variflight\.com\/airport\/(in|out)queuev5 url script-response-body https://cdn.jsdelivr.net/gh/fmwgz8n4hr-dotcom/Qx@77adc3decadcc30927906770f970e7e88ce830be/feeyo_queue.js

^https?:\/\/app\.variflight\.com\/(v[0-9]+\/|airport|flight) url script-response-body https://cdn.jsdelivr.net/gh/fmwgz8n4hr-dotcom/Qx@77adc3decadcc30927906770f970e7e88ce830be/feeyo_queue.js
