#!name=飞常准 进港排队全天
#!desc=内置解密，把机场接口的全天航班填进排队页。用法：打开「机场」页翻两下（缓存航班），再进排队页。

[mitm]
hostname = *.variflight.com, variflight.com

[rewrite_local]

# 排队页：用解密后的全天航班填充
^https?:\/\/[a-z0-9.-]*variflight\.com\/airport\/(in|out)queuev5 url script-response-body https://cdn.jsdelivr.net/gh/fmwgz8n4hr-dotcom/Qx@29a07d157f0f5082b9ccf7d0ba397dc216dad786/feeyo_queue.js

# 全域名接口：AES 解密 + 航班数据缓存
^https?:\/\/[a-z0-9.-]*variflight\.com\/(v[0-9]+\/|airport|flight) url script-response-body https://cdn.jsdelivr.net/gh/fmwgz8n4hr-dotcom/Qx@29a07d157f0f5082b9ccf7d0ba397dc216dad786/feeyo_queue.js
